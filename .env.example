# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# ✅ للتست من غير مفتاح حقيقي أو أي دفع
MOCK_CLAUDE=false

# ✅ نفس الفكرة للمكالمات - true يخليك تجرب الواجهة كاملة من غير حساب Vapi
MOCK_CALLS=false

# ✅ نفس الفكرة لفحص صندوق الوارد - true بيرجع نتايج وهمية (Sara بس هتظهر إنها بعتت)
MOCK_INBOX=false

# ✅ نفس الفكرة للإيميل - true بيخليك تجرب Send All من غير حساب SMTP حقيقي
MOCK_EMAIL=false

# ✅ نفس الفكرة لتحويل الصوت لنص - true بيرجع نص تجريبي ثابت من غير حساب OpenAI
MOCK_TRANSCRIBE=false

# SMTP + IMAP (نفس حساب Gmail بيتستخدم للاتنين - محتاج App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=HR Department

# الإيميل اللي هيوصله تنبيه فوري (سؤال/رد محتاج قرارك) - افتراضيًا نفس SMTP_USER،
# سيبها فاضية لو عايز تستخدم نفس حساب الإرسال، أو حط إيميلك الشخصي هنا
MANAGER_NOTIFY_EMAIL=
IMAP_HOST=imap.gmail.com

# Vapi.ai (المكالمات الصوتية التفاعلية)
VAPI_API_KEY=your-vapi-private-key
VAPI_PHONE_NUMBER_ID=your-vapi-phone-number-id

# اختياري - تحكم في سرعة/دقة المكالمات (القيم دي افتراضية كويسة، غيّرها لو عايز تجرب)
VAPI_CALL_MODEL=claude-haiku-4-5-20251001
VAPI_TRANSCRIBER_MODEL_EN=nova-3
VAPI_TRANSCRIBER_MODEL_AR=nova-3
VAPI_TRANSCRIBER_LANGUAGE_AR=ar
# جرب "ar-EG" للهجة المصرية تحديدًا، أو "multi" لو محتاج تبديل تلقائي بين لغتين
# في نفس المكالمة (على حساب دقة العربي)

# OpenAI (تحويل الصوت لنص - مستقل عن Web Speech API بتاعة جوجل)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
